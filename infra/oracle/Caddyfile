# Caddy 2 — automatic Let's Encrypt TLS + reverse proxy.
# Replace ${DOMAIN} via Caddy's env var support (passed in docker-compose).

{
    email {$ACME_EMAIL}
    servers {
        protocols h1 h2 h3
    }
}

api.{$DOMAIN} {
    encode zstd gzip
    # SSE / streaming: disable buffering, long-lived
    reverse_proxy backend:3001 {
        flush_interval -1
        transport http {
            read_timeout  30m
            write_timeout 30m
        }
    }
}

router.{$DOMAIN} {
    encode zstd gzip
    reverse_proxy ninerouter:3000 {
        flush_interval -1
    }
}
