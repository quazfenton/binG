# ── Modal Configuration ──────────────────────────────────────────────
# Copy to .env and fill in your values

# Modal will pick these up automatically when deployed
# Set these via: modal secret create bing-modal-secrets

# Backend URL that Modal workers call back to for tool execution
BACKEND_URL=http://localhost:3001

# LLM API keys (for running inference on Modal)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=

# Sandbox configuration
SANDBOX_MEMORY_LIMIT=2GB
SANDBOX_TIMEOUT_SECONDS=120

# Storage (Cloudflare R2 compatible)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
