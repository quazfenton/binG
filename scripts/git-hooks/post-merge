#!/bin/bash
# Post-merge hook — re-install git hooks after every `git pull` / `git merge`
# so .git/hooks/pre-push (and friends) never drift apart from the canonical
# sources in scripts/git-hooks/ and scripts/git-pre-push.sh.
#
# This hook is itself symlinked from .git/hooks/post-merge →
# scripts/git-hooks/post-merge by scripts/install-hooks.sh.
#
# Failures are intentionally non-fatal: a broken installer should never
# break the user's merge.

# The hook runs inside a git repo, so rev-parse gives us the root directly —
# no symlink resolution or Python fallback needed.
REPO_ROOT="$(git rev-parse --show-toplevel)"
INSTALL_HOOKS="${REPO_ROOT}/scripts/install-hooks.sh"

[ -f "${INSTALL_HOOKS}" ] || exit 0

# Run silently; never abort the merge on a hook-install failure.
bash "${INSTALL_HOOKS}" >/dev/null 2>&1 || true
