+  ]},
+];
+
+/**
+ * Pick the best role for a request across all three prompt sets.
+ *
+ * Returns null when no role pattern matches strongly. Callers should then
+ * fall back to their own default (typically `coder` if filesystem edits are
+ * enabled, otherwise no role prompt at all).
+ */
+export function pickRoleFromContext(ctx: PickRoleContext): UnifiedRoleInfo | null {
+  const text = (ctx.taskDescription || '').toLowerCase();
+
+  // Failure context biases toward debugger.
+  if (ctx.recentFailures && ctx.recentFailures.length >= 2) {
+    return { role: 'debugger', source: 'core' };
+  }
+
+  if (text.length > 0) {
+    let best: { role: UnifiedRole; score: number } | null = null;
+    for (const { role, patterns } of ROLE_PATTERNS) {
+      let score = 0;
+      for (const re of patterns) {
+        if (re.test(text)) score += 1;
+      }
+      if (score > 0 && (!best || score > best.score)) {
+        best = { role, score };
+      }
+    }
+    if (best) {
+      const source = getRoleSource(best.role as string)!;
+      return { role: best.role, source };
+    }
+  }
+
+  // No keyword match: fall back to complexity/tool-availability heuristics.
+  if (ctx.complexity === 'complex') {
+    return { role: 'architect', source: 'core' };
+  }
+  if (ctx.enableFilesystemEdits) {
+    return { role: 'coder', source: 'core' };
+  }
+  return null;
+}
+
+// ============================================================================
+// Composition — dispatch to the right composer per source
+// ============================================================================
+
+const DEFAULT_MAX_LENGTH = 6000;
+
+/**
+ * Compose a system prompt for ANY of the 44 roles.
+ *
+ * - Core roles go through `composeRoleWithTools` so they get section-aware
+ *   composition + dynamic tool block injection.
+ * - Supplementary and general v4 roles are raw strings today (no section
+ *   decomposition exists for them), so we return the raw prompt.
+ */
+export function composeUnifiedRolePrompt(
+  role: UnifiedRole,
+  opts: ComposeUnifiedOptions = {},
+): string {
+  const source = getRoleSource(role as string);
+  const maxLength = opts.maxLength ?? DEFAULT_MAX_LENGTH;
+  let prompt = '';
+
+  const rawForSource = (): string => {
+    switch (source) {
+      case 'core': return getSystemPrompt(role as AgentRole);
+      case 'supplementary': return getSupplementaryPrompt(role as SupplementaryAgentRole);
+      case 'general': return getGeneralPrompt(role as GeneralDomainRole);
+      case 'general-v2': return getGeneralPromptV2(role as GeneralDomainRoleV2);
+      case 'general-v3': return getGeneralPromptV3(role as GeneralDomainRoleV3);
+      case 'general-v4': return getGeneralPromptV4(role as GeneralDomainRoleV4);
+      default: return '';
+    }
+  };
+
+  try {
+    if (source === 'core') {
+      // Core roles support section-aware composition with dynamic tool block.
+      prompt = composeRoleWithTools(role as AgentRole, {
+        availableTools: opts.availableTools || [],
+        extras: opts.extras?.map((s, i) => ({ id: `extra.${i}`, template: s })),
+      });
+    } else if (source) {
+      // Non-core sets are raw strings today (no section decomposition).
+      prompt = rawForSource();
+      if (opts.extras?.length) prompt += '\n\n' + opts.extras.join('\n\n');
+    } else {
+      return '';
+    }
+  } catch {
+    // Best-effort fallback to raw prompt for the source.
+    prompt = rawForSource();
+  }
+
+  return prompt.length > maxLength ? prompt.slice(0, maxLength) : prompt;
+}
+
+/**
+ * One-shot: pick a role from context and compose its prompt.
+ *
+ * Returns `null` when the context doesn't justify a role prompt at all
+ * (e.g. plain non-code chat with no filesystem tools); callers should treat
+ * that as "no role identity, use whatever default system prompt you had".
+ */
+export function selectAndComposeSystemPrompt(
+  ctx: PickRoleContext,
+  opts: ComposeUnifiedOptions = {},
+): (UnifiedRoleInfo & { prompt: string }) | null {
+  const picked = pickRoleFromContext(ctx);
+  if (!picked) return null;
+  const prompt = composeUnifiedRolePrompt(picked.role, opts);
+  if (!prompt) return null;
+  return { ...picked, prompt };
+}
