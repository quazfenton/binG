+  getGeneralPrompt,
+} from './general-domain-prompts';
+import {
+  GENERAL_PROMPTS_V2,
+  type GeneralDomainRoleV2,
+  getGeneralPromptV2,
+} from './general-domain-prompts-v2';
+import {
+  GENERAL_PROMPTS_V3,
+  type GeneralDomainRoleV3,
+  getGeneralPromptV3,
+} from './general-domain-prompts-v3';
+import {
+  GENERAL_PROMPTS_V4,
+  type GeneralDomainRoleV4,
+  getGeneralPromptV4,
+} from './general-domain-prompts-v4';
+import { composeRoleWithTools } from './prompt-composer';
+
+// ============================================================================
+// Types
+// ============================================================================
+
+export type UnifiedRole =
+  | AgentRole
+  | SupplementaryAgentRole
+  | GeneralDomainRole
+  | GeneralDomainRoleV2
+  | GeneralDomainRoleV3
+  | GeneralDomainRoleV4;
+
+export type RoleSource = 'core' | 'supplementary' | 'general' | 'general-v2' | 'general-v3' | 'general-v4';
+
+export interface UnifiedRoleInfo {
+  role: UnifiedRole;
+  source: RoleSource;
+}
+
+export interface PickRoleContext {
+  /** The user prompt / task description. */
+  taskDescription?: string;
+  /** Classifier complexity bucket. */
+  complexity?: 'simple' | 'moderate' | 'complex' | string;
+  /** Whether filesystem-edit tools are enabled. Bias toward `coder`. */
+  enableFilesystemEdits?: boolean;
+  /** Recent failure messages (debugger bias). */
+  recentFailures?: string[];
+}
+
+export interface ComposeUnifiedOptions {
+  /** Tool IDs available to the model (passed to composeRoleWithTools). */
+  availableTools?: string[];
+  /** Hard cap on returned prompt length (chars). */
+  maxLength?: number;
+  /** Extra string sections to append. */
+  extras?: string[];
+}
+
+// ============================================================================
+// Core: enumerate all roles across the three sets
+// ============================================================================
+
+const CORE_ROLE_SET = new Set<string>(Object.keys(SYSTEM_PROMPTS));
+const SUP_ROLE_SET = new Set<string>(Object.keys(SUPPLEMENTARY_PROMPTS));
+const GEN_V1_ROLE_SET = new Set<string>(Object.keys(GENERAL_PROMPTS));
+const GEN_V2_ROLE_SET = new Set<string>(Object.keys(GENERAL_PROMPTS_V2));
+const GEN_V3_ROLE_SET = new Set<string>(Object.keys(GENERAL_PROMPTS_V3));
+const GEN_V4_ROLE_SET = new Set<string>(Object.keys(GENERAL_PROMPTS_V4));
+
+export function getAllRoleIds(): UnifiedRole[] {
+  return [
+    ...(Object.keys(SYSTEM_PROMPTS) as AgentRole[]),
+    ...(Object.keys(SUPPLEMENTARY_PROMPTS) as SupplementaryAgentRole[]),
+    ...(Object.keys(GENERAL_PROMPTS) as GeneralDomainRole[]),
+    ...(Object.keys(GENERAL_PROMPTS_V2) as GeneralDomainRoleV2[]),
+    ...(Object.keys(GENERAL_PROMPTS_V3) as GeneralDomainRoleV3[]),
+    ...(Object.keys(GENERAL_PROMPTS_V4) as GeneralDomainRoleV4[]),
+  ];
+}
+
+export function getRoleSource(role: string): RoleSource | null {
+  if (CORE_ROLE_SET.has(role)) return 'core';
+  if (SUP_ROLE_SET.has(role)) return 'supplementary';
+  if (GEN_V1_ROLE_SET.has(role)) return 'general';
+  if (GEN_V2_ROLE_SET.has(role)) return 'general-v2';
+  if (GEN_V3_ROLE_SET.has(role)) return 'general-v3';
+  if (GEN_V4_ROLE_SET.has(role)) return 'general-v4';
+  return null;
+}
+
+/**
+ * Replacement for the misleadingly named `getAllPrompts()` in the
+ * supplementary file (which only returned its own set). This one actually
+ * merges all six prompt sources. Role keys are unique across all sets — a
+ * runtime invariant we verify in tests.
+ */
+export function getAllRolePrompts(): Record<string, string> {
+  return {
+    ...SYSTEM_PROMPTS,
+    ...SUPPLEMENTARY_PROMPTS,
+    ...GENERAL_PROMPTS,
+    ...GENERAL_PROMPTS_V2,
+    ...GENERAL_PROMPTS_V3,
+    ...GENERAL_PROMPTS_V4,
+  };
+}
+
+// ============================================================================
+// Keyword router — extends role-redirector's logic to cover all 3 sets
+// ============================================================================
+
+/**
+ * Role-keyword table. Patterns are matched against a lowercased task string;
+ * the role with the highest match score wins. Patterns are intentionally
+ * narrow to avoid over-triggering on common code words (e.g. we don't claim
+ * `mlEngineer` on the word "model" alone).
