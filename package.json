{
  "name": "bing",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-runner.js",
    "dev:raw": "turbo dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:web": "pnpm --filter web dev",
    "dev:desktop": "pnpm --filter desktop tauri dev",
    "build": "pnpm --filter web build",
    "build:web": "pnpm --filter web build",
    "build:desktop": "pnpm --filter desktop tauri build",
    "start": "pnpm --filter web start",
    "start:web": "pnpm --filter web start",
    "type-check": "pnpm --filter web type-check",
    "lint": "pnpm --filter web lint",
    "test": "pnpm --filter web test && vitest run",
    "test:ci": "pnpm --filter web test",
    "test:unit": "vitest run",

    "env:check": "node scripts/compare-env.mjs web/.env web/.env.example",
    "logs": "node tail-logs.js",

    "sqlite:rebuild": "pnpm rebuild better-sqlite3",

    "check:vendor-drift": "tsx scripts/check-vendor-api-drift.ts",
    "check:vendor-drift:update": "tsx scripts/check-vendor-api-drift.ts --check=vendor --update",
    "preflight": "scripts/preflight.sh"
  },
  "devDependencies": {
    "@octokit/rest": "^22.0.1",
    "@playwright/mcp": "^0.0.70",
    "axios": "^1.16.0",
    "dotenv": "^17.4.2",
    "fast-levenshtein": "^3.0.0",
    "fs-extra": "^11.3.4",
    "fuse.js": "^7.3.0",
    "gray-matter": "^4.0.3",
    "openai": "^6.34.0",
    "remark": "^15.0.1",
    "simple-git": "^3.36.0",
    "slugify": "^1.6.9",
    "tsx": "^4.21.0",
    "turbo": "^2.0.0",
    "unified": "^11.0.5",
    "vitest": "^4.0.18"
  },
  "resolutions": {
    "fast-xml-parser": ">=5.3.6",
    "next": ">=15.5.10"
  }
}

